//-----------------------------------------------------------------------------
//	HAMMER_RUN_MAP_LAUNCHER.VPC
//
//	Project Script
//-----------------------------------------------------------------------------

$Macro SRCDIR		"..\.."
$Macro OUTBINDIR	"$SRCDIR\..\game\bin"

$Include "$SRCDIR\vpc_scripts\source_exe_con_base.vpc"

$Configuration
{
	$Compiler
	{
		// Language
		$EnableC++Exceptions			"Yes (/EHsc)"	[$WINDOWS]
	}
}

$Project "hammer_run_map_launcher"
{
	$Folder	"Source Files"
	{
		-$File	"$SRCDIR\public\tier0\memoverride.cpp"
		$File	"main.cpp"
	}

	$Folder	"Link Libraries" 
	{
		-$Lib tier0 [$WINDOWS]
		-$Lib tier1 [$WINDOWS]
		-$Lib vstdlib [$WINDOWS]
	}
}
