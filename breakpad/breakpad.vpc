		$File	"$SRCDIR/thirdparty/breakpad/src/client/mac/handler/breakpad_nlist_64.cc"
	}

	$Folder	"Header Files"
	{
		$File	"$SRCDIR/thirdparty/breakpad/src/client/windows/handler/exception_handler.h"	[$WINDOWS]
		$File	"$SRCDIR/thirdparty/breakpad/src/client/windows/sender/crash_report_sender.h"	[$WINDOWS]

		$File	"$SRCDIR/thirdparty/breakpad/src/client/linux/handler/exception_handler.h"	[$LINUX]
		$File	"$SRCDIR/thirdparty/breakpad/src/client/linux/handler/minidump_descriptor.h"	[$LINUX]

		$File	"$SRCDIR/thirdparty/breakpad/src/client/mac/handler/exception_handler.h"	[$OSX]
